{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM"],
    "types": ["miniprogram-api-typings", "vitest/globals"]
  },
  "include": ["miniprogram/**/*.ts", "tests/**/*.ts"]
}
