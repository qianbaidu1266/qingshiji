<view class="page">
  <view class="statusbar" style="height: {{statusBarHeight}}px;"></view>
  <text class="page-title">趋势</text>

  <view class="card">
    <view class="kv-row">
      <text class="kv-row__label">7 日平均体重</text>
      <text class="kv-row__value num">{{latestAverage}} kg</text>
    </view>
    <view class="divider"></view>
    <view class="kv-row">
      <text class="kv-row__label">近期变化</text>
      <text class="kv-row__value">{{trendText}}</text>
    </view>
  </view>

  <view class="section">
    <text class="section__title">体重曲线</text>
    <view class="card">
      <block wx:if="{{hasData}}">
        <text class="placeholder">图表组件待接入（ECharts 或自绘 Canvas）</text>
      </block>
      <view wx:else class="placeholder" bindtap="onAddWeight">
        还没有体重记录
        <text style="display:block;margin-top:16rpx;color:var(--accent);">记录一次</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section__title">热量与打卡</text>
    <view class="card">
      <text class="placeholder">热量趋势与打卡日历开发中</text>
    </view>
  </view>

  <view class="tabbar-placeholder"></view>
</view>
