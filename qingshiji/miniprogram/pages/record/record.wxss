/* ---------------- 顶部导航 ---------------- */
.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 32rpx;
}

.nav__back {
  min-width: 100rpx;
}

.nav__back--placeholder {
  visibility: hidden;
}

.nav__back-text {
  font-size: 30rpx;
  color: var(--accent);
}

.nav__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ---------------- 餐次选择 ---------------- */
.meal-seg {
  display: flex;
  gap: 12rpx;
  padding: 4rpx;
  background: var(--surface-soft);
  border-radius: var(--radius-pill);
}

.meal-seg__item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  color: var(--text-secondary);
  transition: all 0.18s ease;
}

.meal-seg__item--on {
  background: var(--accent);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(79, 122, 85, 0.22);
}

/* ---------------- 搜索 ---------------- */
.search {
  position: relative;
  margin-top: 32rpx;
}

.search__input {
  height: 88rpx;
  padding: 0 76rpx 0 32rpx;
  background: var(--surface-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-medium);
  font-size: 28rpx;
  color: var(--text-primary);
}

.search__ph {
  color: var(--text-tertiary);
}

.search__clear {
  position: absolute;
  right: 0;
  top: 0;
  width: 76rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* ---------------- 食物列表 ---------------- */
.food-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 36rpx;
  border-bottom: 2rpx solid var(--divider);
}

.food-row:last-child {
  border-bottom: none;
}

.food-row--on {
  background: var(--accent-soft);
}

.food-row__main {
  flex: 1;
  min-width: 0;
}

.food-row__name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.food-row--on .food-row__name {
  font-weight: 600;
  color: var(--accent-deep);
}

.food-row__meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.food-row__check {
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent);
}

/* ---------------- 份量 ---------------- */
.portion-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.portion {
  padding: 16rpx 32rpx;
  background: var(--surface-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  color: var(--text-secondary);
}

.portion--on {
  background: var(--accent);
  border-color: var(--accent);
  color: #ffffff;
  font-weight: 600;
}

/* ---------------- 营养预览 ---------------- */
.preview-card {
  padding: 32rpx;
}

.preview__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid var(--divider);
}

.preview__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.preview__kcal {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent);
}

.preview__macros {
  display: flex;
  padding-top: 24rpx;
}

.pmacro {
  flex: 1;
  text-align: center;
}

.pmacro__label {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.pmacro__value {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ---------------- 保存按钮 ---------------- */
.btn-save {
  margin-top: 48rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent);
  border-radius: var(--radius-medium);
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(79, 122, 85, 0.22);
}

.btn-save:active {
  opacity: 0.85;
}

.btn-save--disabled {
  background: var(--text-tertiary);
  box-shadow: none;
}

.tabbar-placeholder {
  height: 80rpx;
}
