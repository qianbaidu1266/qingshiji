/* ---------------- 顶部导航 ---------------- */
.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 32rpx;
}

.nav__back {
  min-width: 100rpx;
}

.nav__back--placeholder {
  visibility: hidden;
}

.nav__back-text {
  font-size: 30rpx;
  color: var(--accent);
}

.nav__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ---------------- 表单行 ---------------- */
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 36rpx;
}

.form-row__label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.form-row__input {
  width: 200rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 性别切换 */
.seg {
  display: flex;
  padding: 4rpx;
  background: var(--surface-soft);
  border-radius: var(--radius-pill);
}

.seg__item {
  padding: 10rpx 32rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  color: var(--text-secondary);
  transition: all 0.18s ease;
}

.seg__item--on {
  background: var(--accent);
  color: #ffffff;
  font-weight: 600;
}

/* ---------------- 活动水平 ---------------- */
.activity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 36rpx;
  border-bottom: 2rpx solid var(--divider);
}

.activity:last-child {
  border-bottom: none;
}

.activity--on {
  background: var(--accent-soft);
}

.activity__label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.activity--on .activity__label {
  font-weight: 600;
  color: var(--accent-deep);
}

.activity__check {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
}

/* ---------------- 高亮行 ---------------- */
.kv-row--highlight .kv-row__value {
  color: var(--accent);
  font-size: 32rpx;
}

/* ---------------- 拦截提示 ---------------- */
.alert {
  padding: 32rpx;
  background: var(--warn-soft);
  border-radius: var(--radius-card);
  margin-bottom: 24rpx;
}

.alert__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--warn);
}

.alert__body {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-primary);
  white-space: pre-wrap;
}

.alert__action {
  display: inline-block;
  margin-top: 28rpx;
  padding: 16rpx 36rpx;
  background: var(--warn);
  border-radius: var(--radius-medium);
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}

.alert__action:active {
  opacity: 0.85;
}

/* ---------------- 运动建议 ---------------- */
.hint {
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  background: var(--accent-soft);
  border-radius: var(--radius-medium);
}

.hint__text {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--accent-deep);
}

/* ---------------- 保存按钮 ---------------- */
.btn-save {
  margin-top: 48rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent);
  border-radius: var(--radius-medium);
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(79, 122, 85, 0.22);
}

.btn-save:active {
  opacity: 0.85;
}

.btn-save--disabled {
  background: var(--text-tertiary);
  box-shadow: none;
}
