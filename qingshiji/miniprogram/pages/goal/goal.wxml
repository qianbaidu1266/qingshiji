<view class="page">
  <view class="statusbar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 返回与标题 -->
  <view class="nav">
    <view class="nav__back" bindtap="onBack">
      <text class="nav__back-text">返回</text>
    </view>
    <text class="nav__title">设置减脂目标</text>
    <view class="nav__back nav__back--placeholder"></view>
  </view>

  <!-- 基础档案 -->
  <view class="section">
    <text class="section__title">基础档案</text>
    <view class="card">
      <view class="form-row">
        <text class="form-row__label">性别</text>
        <view class="seg">
          <view
            class="seg__item {{gender === 'male' ? 'seg__item--on' : ''}}"
            data-value="male"
            bindtap="onGenderChange"
          >
            <text>男</text>
          </view>
          <view
            class="seg__item {{gender === 'female' ? 'seg__item--on' : ''}}"
            data-value="female"
            bindtap="onGenderChange"
          >
            <text>女</text>
          </view>
        </view>
      </view>

      <view class="divider"></view>

      <view class="form-row">
        <text class="form-row__label">出生年份</text>
        <input
          class="form-row__input num"
          type="number"
          value="{{birthYear}}"
          data-field="birthYear"
          bindinput="onNumberInput"
          placeholder="1998"
        />
      </view>

      <view class="divider"></view>

      <view class="form-row">
        <text class="form-row__label">身高 (cm)</text>
        <input
          class="form-row__input num"
          type="digit"
          value="{{height}}"
          data-field="height"
          bindinput="onNumberInput"
          placeholder="165"
        />
      </view>

      <view class="divider"></view>

      <view class="form-row">
        <text class="form-row__label">当前体重 (kg)</text>
        <input
          class="form-row__input num"
          type="digit"
          value="{{weight}}"
          data-field="weight"
          bindinput="onNumberInput"
          placeholder="60"
        />
      </view>
    </view>
  </view>

  <!-- 活动水平 -->
  <view class="section">
    <text class="section__title">日常活动水平</text>
    <view class="card">
      <view
        class="activity {{activityLevel === item.value ? 'activity--on' : ''}}"
        wx:for="{{activityOptions}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onActivityChange"
      >
        <text class="activity__label">{{item.label}}</text>
        <text wx:if="{{activityLevel === item.value}}" class="activity__check">✓</text>
      </view>
    </view>
  </view>

  <!-- 目标 -->
  <view class="section">
    <text class="section__title">你的目标</text>
    <view class="card">
      <view class="form-row">
        <text class="form-row__label">目标体重 (kg)</text>
        <input
          class="form-row__input num"
          type="digit"
          value="{{targetWeight}}"
          data-field="targetWeight"
          bindinput="onNumberInput"
          placeholder="55"
        />
      </view>
      <view class="divider"></view>
      <view class="form-row">
        <text class="form-row__label">期望周期 (周)</text>
        <input
          class="form-row__input num"
          type="number"
          value="{{targetWeeks}}"
          data-field="targetWeeks"
          bindinput="onNumberInput"
          placeholder="12"
        />
      </view>
    </view>
  </view>

  <!-- 实时测算结果 -->
  <view class="section" wx:if="{{complete && preview}}">
    <text class="section__title">测算结果</text>

    <!-- 拦截提示 -->
    <view class="alert" wx:if="{{blocked}}">
      <text class="alert__title">这个目标无法安全执行</text>
      <text class="alert__body">{{validation.message}}</text>
      <view class="alert__action" bindtap="onAcceptSuggestion">
        <text>采纳建议方案（{{preview.estimatedWeeks}} 周）</text>
      </view>
    </view>

    <view class="card">
      <view class="kv-row">
        <text class="kv-row__label">基础代谢 BMR</text>
        <text class="kv-row__value num">{{preview.bmr}} kcal</text>
      </view>
      <view class="divider"></view>
      <view class="kv-row">
        <text class="kv-row__label">每日消耗 TDEE</text>
        <text class="kv-row__value num">{{preview.tdee}} kcal</text>
      </view>
      <view class="divider"></view>
      <view class="kv-row kv-row--highlight">
        <text class="kv-row__label">每日摄入目标</text>
        <text class="kv-row__value num">{{preview.calorieTarget}} kcal</text>
      </view>
      <view class="divider"></view>
      <view class="kv-row">
        <text class="kv-row__label">蛋白质</text>
        <text class="kv-row__value num">{{preview.protein}} g</text>
      </view>
      <view class="divider"></view>
      <view class="kv-row">
        <text class="kv-row__label">脂肪</text>
        <text class="kv-row__value num">{{preview.fat}} g</text>
      </view>
      <view class="divider"></view>
      <view class="kv-row">
        <text class="kv-row__label">碳水</text>
        <text class="kv-row__value num">{{preview.carb}} g</text>
      </view>
      <view class="divider"></view>
      <view class="kv-row">
        <text class="kv-row__label">每周减重</text>
        <text class="kv-row__value num">{{preview.weeklyLoss}} kg</text>
      </view>
    </view>

    <!-- 运动价值提示 -->
    <view class="hint" wx:if="{{validation.suggestion.advice}}">
      <text class="hint__text">{{validation.suggestion.advice}}</text>
    </view>
  </view>

  <view class="btn-save {{blocked ? 'btn-save--disabled' : ''}}" bindtap="onSave">
    <text>{{blocked ? '目标未通过安全校验' : '保存并生成方案'}}</text>
  </view>

  <view class="tabbar-placeholder"></view>
</view>
